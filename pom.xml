<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.14</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.superbowlrun</groupId>
	<artifactId>superbowlrun-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>superbowlrun-parent</name>
	<description>All-Time Team Builder: Super Bowl Run (modular monolith)</description>

	<!--
	  Modular monolith: one build, one deployable (the app module), but the code is split into
	  modules with enforced dependency boundaries.
	    model       <- pure domain records (no deps)
	    engine      <- game logic: data load + draft + rating + projection (depends on model)
	    persistence <- saved teams + personal best (JPA + H2; independent)
	    app         <- Spring Boot main + REST API + CLI + run orchestration (depends on engine + persistence)
	-->
	<modules>
		<module>model</module>
		<module>engine</module>
		<module>persistence</module>
		<module>app</module>
	</modules>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Internal module versions, so child POMs don't repeat the version. -->
			<dependency>
				<groupId>com.superbowlrun</groupId>
				<artifactId>superbowlrun-model</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.superbowlrun</groupId>
				<artifactId>superbowlrun-engine</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.superbowlrun</groupId>
				<artifactId>superbowlrun-persistence</artifactId>
				<version>${project.version}</version>
			</dependency>
			<!-- Third-party versions not managed by Spring Boot's parent. -->
			<dependency>
				<groupId>com.opencsv</groupId>
				<artifactId>opencsv</artifactId>
				<version>5.9</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
